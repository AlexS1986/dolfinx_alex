\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Position of the surfing boundary condition \(x_{\rm  bc}\) and extracted crack-tip position \(x_{\rm  ct}\) for the reference inclusion case \(w_s=1.0L\), \(k_{\rm  inc}=1.0\), and \(g_{\text  {inc}}=1.0\).}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:crack_tip_tracking}{{3}{7}{Position of the surfing boundary condition \(x_{\rm bc}\) and extracted crack-tip position \(x_{\rm ct}\) for the reference inclusion case \(w_s=1.0L\), \(\Kinc =1.0\), and \(\Ginc =1.0\)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces J-integral over crack-tip position for \(w_s=1.0L\): the reference material contrast \((k_{\rm  inc},g_{\text  {inc}})=(1.0,1.0)\), stiff weak inclusions \((1.5,0.5)\), and compliant inclusions with matrix-matched fracture resistance \((0.5,1.0)\).}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:Jx_xct_stiffness}{{4}{8}{J-integral over crack-tip position for \(w_s=1.0L\): the reference material contrast \((\Kinc ,\Ginc )=(1.0,1.0)\), stiff weak inclusions \((1.5,0.5)\), and compliant inclusions with matrix-matched fracture resistance \((0.5,1.0)\)}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Section of the J-integral \(J_x\) versus crack-tip position \(x_{\rm  ct}\) for \(g_{\text  {inc}}=0.5\). Only the interaction pattern spanning inclusions 4 through 6 is shown; for \(w_s=L\), this corresponds approximately to \(6\le x_{\rm  ct}/L \le 10\). The three panels show the available simulations for \(k_{\rm  inc}=0.5\), \(1.0\), and \(1.5\); within each panel the curves correspond to different ligament widths \(w_s\).}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:Jx_sections_Gcinc_0p5}{{5}{9}{Section of the J-integral \(J_x\) versus crack-tip position \(x_{\rm ct}\) for \(\Ginc =0.5\). Only the interaction pattern spanning inclusions 4 through 6 is shown; for \(w_s=L\), this corresponds approximately to \(6\le x_{\rm ct}/L \le 10\). The three panels show the available simulations for \(\Kinc =0.5\), \(1.0\), and \(1.5\); within each panel the curves correspond to different ligament widths \(w_s\)}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Section of the J-integral \(J_x\) versus crack-tip position \(x_{\rm  ct}\) for \(g_{\text  {inc}}=1.0\). Only the interaction pattern spanning inclusions 4 through 6 is shown; for \(w_s=L\), this corresponds approximately to \(6\le x_{\rm  ct}/L \le 10\). For the stiff-inclusion case \(k_{\rm  inc}=1.5\), the lower bound of this interval is shifted by \(w_s\) to exclude the preceding interaction. The three panels show the available simulations for \(k_{\rm  inc}=0.5\), \(1.0\), and \(1.5\); within each panel the curves correspond to different ligament widths \(w_s\).}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:Jx_sections_Gcinc_1p0}{{6}{10}{Section of the J-integral \(J_x\) versus crack-tip position \(x_{\rm ct}\) for \(\Ginc =1.0\). Only the interaction pattern spanning inclusions 4 through 6 is shown; for \(w_s=L\), this corresponds approximately to \(6\le x_{\rm ct}/L \le 10\). For the stiff-inclusion case \(\Kinc =1.5\), the lower bound of this interval is shifted by \(w_s\) to exclude the preceding interaction. The three panels show the available simulations for \(\Kinc =0.5\), \(1.0\), and \(1.5\); within each panel the curves correspond to different ligament widths \(w_s\)}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Section of the J-integral \(J_x\) versus crack-tip position \(x_{\rm  ct}\) for \(g_{\text  {inc}}=1.5\). Only the interaction pattern spanning inclusions 4 through 6 is shown; for \(w_s=L\), this corresponds approximately to \(6\le x_{\rm  ct}/L \le 10\). The three panels show the available simulations for \(k_{\rm  inc}=0.5\), \(1.0\), and \(1.5\); within each panel the curves correspond to different ligament widths \(w_s\). The vertical axis is restricted to \(1.3\le J_x/G_c^0\le 2\) to emphasize the relevant peak structure.}}{11}{figure.7}\protected@file@percent }
\newlabel{fig:Jx_sections_Gcinc_1p5}{{7}{11}{Section of the J-integral \(J_x\) versus crack-tip position \(x_{\rm ct}\) for \(\Ginc =1.5\). Only the interaction pattern spanning inclusions 4 through 6 is shown; for \(w_s=L\), this corresponds approximately to \(6\le x_{\rm ct}/L \le 10\). The three panels show the available simulations for \(\Kinc =0.5\), \(1.0\), and \(1.5\); within each panel the curves correspond to different ligament widths \(w_s\). The vertical axis is restricted to \(1.3\le J_x/\GcZero \le 2\) to emphasize the relevant peak structure}{figure.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Effective crack resistance}{12}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Effective crack resistance \(J_{x,c}^{\rm  eff}\) versus ligament width \(w_s\). Each panel fixes the inclusion fracture-resistance factor \(g_{\text  {inc}}\) and compares the three inclusion stiffness factors.}}{12}{figure.8}\protected@file@percent }
\newlabel{fig:Jeff_wsteg_families}{{8}{12}{Effective crack resistance \(\Jeff \) versus ligament width \(w_s\). Each panel fixes the inclusion fracture-resistance factor \(\Ginc \) and compares the three inclusion stiffness factors}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Normalized effective crack resistance at selected ligament widths: a) \(w_s=0.5L\), b) \(w_s=1.0L\), and c) \(w_s=2.0L\). Each cell shows \(J_{x,c}^{\rm  eff}\) divided by the corresponding baseline value for \((k_{\rm  inc},g_{\text  {inc}})=(1.0,1.0)\) at the same \(w_s\). Weak compliant inclusions \((0.5,0.5)\) give the lowest response, whereas tough compliant inclusions \((0.5,1.5)\) give the largest response in all three panels.}}{13}{figure.9}\protected@file@percent }
\newlabel{fig:combined_parameter_contribution}{{9}{13}{Normalized effective crack resistance at selected ligament widths: a) \(w_s=0.5L\), b) \(w_s=1.0L\), and c) \(w_s=2.0L\). Each cell shows \(\Jeff \) divided by the corresponding baseline value for \((\Kinc ,\Ginc )=(1.0,1.0)\) at the same \(w_s\). Weak compliant inclusions \((0.5,0.5)\) give the lowest response, whereas tough compliant inclusions \((0.5,1.5)\) give the largest response in all three panels}{figure.9}{}}
