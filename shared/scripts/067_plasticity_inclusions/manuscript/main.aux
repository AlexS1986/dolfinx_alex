\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Position of the surfing boundary condition \(x_{\rm  bc}\) and extracted crack-tip position \(x_{\rm  ct}\) for the reference inclusion case \(w_s=1.0L\), \(k_{\rm  inc}=1.0\), and \(G_{c,\rm  inc}=G_c^0\).}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:crack_tip_tracking}{{3}{8}{Position of the surfing boundary condition \(x_{\rm bc}\) and extracted crack-tip position \(x_{\rm ct}\) for the reference inclusion case \(w_s=1.0L\), \(\Kinc =1.0\), and \(\Gcinc =\GcZero \)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces J-integral over crack-tip position for \(w_s=1.0L\) and constant inclusion fracture resistance \(G_{c,\rm  inc}=G_c^0\). The inclusion stiffness is varied from compliant to stiff.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:Jx_xct_stiffness}{{4}{8}{J-integral over crack-tip position for \(w_s=1.0L\) and constant inclusion fracture resistance \(\Gcinc =\GcZero \). The inclusion stiffness is varied from compliant to stiff}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Section of the J-integral \(J_x\) versus crack-tip position \(x_{\rm  ct}\) for \(G_{c,\rm  inc}=0.5G_c^0\). Only the characteristic evaluation range determined with \(starting\_hole\_to\_evaluate=4\) is shown; for \(w_s=L\), this corresponds approximately to \(6\le x_{\rm  ct}/L \le 10\). The three panels show the available simulations for \(k_{\rm  inc}=0.5\), \(1.0\), and \(1.5\); within each panel the curves correspond to different ligament widths \(w_s\).}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:Jx_sections_Gcinc_0p5}{{5}{9}{Section of the J-integral \(J_x\) versus crack-tip position \(x_{\rm ct}\) for \(\Gcinc =0.5\GcZero \). Only the characteristic evaluation range determined with \(starting\_hole\_to\_evaluate=4\) is shown; for \(w_s=L\), this corresponds approximately to \(6\le x_{\rm ct}/L \le 10\). The three panels show the available simulations for \(\Kinc =0.5\), \(1.0\), and \(1.5\); within each panel the curves correspond to different ligament widths \(w_s\)}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Section of the J-integral \(J_x\) versus crack-tip position \(x_{\rm  ct}\) for \(G_{c,\rm  inc}=G_c^0\). Only the characteristic evaluation range determined with \(starting\_hole\_to\_evaluate=4\) is shown; for \(w_s=L\), this corresponds approximately to \(6\le x_{\rm  ct}/L \le 10\). For the stiff-inclusion case \(k_{\rm  inc}=1.5\), the lower bound of the evaluation interval is shifted by \(w_s\) to exclude the preceding interaction. The three panels show the available simulations for \(k_{\rm  inc}=0.5\), \(1.0\), and \(1.5\); within each panel the curves correspond to different ligament widths \(w_s\).}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:Jx_sections_Gcinc_1p0}{{6}{10}{Section of the J-integral \(J_x\) versus crack-tip position \(x_{\rm ct}\) for \(\Gcinc =\GcZero \). Only the characteristic evaluation range determined with \(starting\_hole\_to\_evaluate=4\) is shown; for \(w_s=L\), this corresponds approximately to \(6\le x_{\rm ct}/L \le 10\). For the stiff-inclusion case \(\Kinc =1.5\), the lower bound of the evaluation interval is shifted by \(w_s\) to exclude the preceding interaction. The three panels show the available simulations for \(\Kinc =0.5\), \(1.0\), and \(1.5\); within each panel the curves correspond to different ligament widths \(w_s\)}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Section of the J-integral \(J_x\) versus crack-tip position \(x_{\rm  ct}\) for \(G_{c,\rm  inc}=1.5G_c^0\). Only the characteristic evaluation range determined with \(starting\_hole\_to\_evaluate=4\) is shown; for \(w_s=L\), this corresponds approximately to \(6\le x_{\rm  ct}/L \le 10\). The three panels show the available simulations for \(k_{\rm  inc}=0.5\), \(1.0\), and \(1.5\); within each panel the curves correspond to different ligament widths \(w_s\). The vertical axis is restricted to \(1.3\le J_x/G_c^0\le 2\) to emphasize the relevant peak structure.}}{11}{figure.7}\protected@file@percent }
\newlabel{fig:Jx_sections_Gcinc_1p5}{{7}{11}{Section of the J-integral \(J_x\) versus crack-tip position \(x_{\rm ct}\) for \(\Gcinc =1.5\GcZero \). Only the characteristic evaluation range determined with \(starting\_hole\_to\_evaluate=4\) is shown; for \(w_s=L\), this corresponds approximately to \(6\le x_{\rm ct}/L \le 10\). The three panels show the available simulations for \(\Kinc =0.5\), \(1.0\), and \(1.5\); within each panel the curves correspond to different ligament widths \(w_s\). The vertical axis is restricted to \(1.3\le J_x/\GcZero \le 2\) to emphasize the relevant peak structure}{figure.7}{}}
