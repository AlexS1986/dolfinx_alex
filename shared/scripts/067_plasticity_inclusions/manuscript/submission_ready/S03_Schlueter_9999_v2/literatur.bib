}

@article{rao_effect_2008,
  title = {Effect of Architecture on Mechanical Properties of Carbon/Carbon Composites},
  author = {Rao, M. Venkat and Mahajan, P. and Mittal, R. K.},
  year = 2008,
  month = apr,
  journal = {Composite Structures},
