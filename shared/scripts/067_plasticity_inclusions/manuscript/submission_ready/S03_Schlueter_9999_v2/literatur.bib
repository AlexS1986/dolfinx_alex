}

@article{chung_pore_2017,
  title = {Pore {{Characteristics}} and {{Their Effects}} on the {{Material Properties}} of {{Foamed Concrete Evaluated Using Micro-CT Images}} and {{Numerical Approaches}}},
  author = {Chung, Sang-Yeop and Lehmann, Christian and Abd Elrahman, Mohamed and Stephan, Dietmar},
  year = 2017,
