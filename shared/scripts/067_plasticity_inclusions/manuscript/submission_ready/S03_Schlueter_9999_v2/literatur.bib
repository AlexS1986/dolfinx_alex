  urldate = {2025-04-04},
  abstract = {Experiments of Parvizi et al. on transverse fracture of cross-ply laminates showed that both energy (Griffith) and strength criteria are necessary conditions for fracture but neither one nor the other are sufficient. Thanks to the singularity at the tip of the notch, the incremental form of the Griffith criterion gives a lower bound of admissible crack lengths. On the contrary, the strength criterion leads to an upper bound. The consistency between these two conditions provides a general form of a criterion for crack nucleation. R\'esum\'e Une exp\'erience de Parvizi et al. sur la rupture transverse des composites crois\'es a montr\'e que les crit\`eres en \'energie (Griffith) et en contraintes sont des conditions n\'ecessaires de rupture mais que ni l'une ni l'autre ne sont suffisantes. Gr\^ace au caract\`ere singulier des contraintes en fond d'entaille, la forme incr\'ementale du crit\`ere de Griffith donne une borne inf\'erieure des tailles de fissures admissibles. Au contraire, le crit\`ere en contraintes fournit une borne sup\'erieure. La compatibilit\'e entre ces deux limites conduit \`a la formulation d'un crit\`ere g\'en\'eral d'amor\c cage de fissure.},
  keywords = {concentration de contraintes,entailles,fracture mechanics,mecanique de la rupture,notches,stress concentrations},
  file = {/Users/alexanderschluter/Zotero/storage/JTDZD92A/Leguillon - 2001 - A criterion for crack nucleation at a notch in homogeneous materials.pdf;/Users/alexanderschluter/Zotero/storage/D63J5W37/S1620774201013022.html}
}

