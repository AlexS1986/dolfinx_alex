@misc{pravda_macroscopic_2026,
	title = {Macroscopic {Porosity} {Optimization} using {Thermodynamic} {Topology} {Optimization}},
	url = {https://www.researchsquare.com/article/rs-9901068/v1},
	doi = {10.21203/rs.3.rs-9901068/v1},
	abstract = {From theoretical investigations, structures with graded, inhomogeneous microstructures are superior to macroscopic ”black-and-white” solutions. Those graded microstructures can be interpreted as ”gray” material with intermediate stiffness between void and the actual solid material in the sense of the homogenization theory. For a long time, those ”gray” solutions were known to be theoretically optimal, but not possible to manufacture. Since the development of sophisticated additive manufacturing processes, the explicit production of microstructures, e.g. triply periodic minimal surface (TPMS) structures, or production of metallic foams, the manufacturing of those ”gray” designs now become realistic. However, those manufacturing processes still have their limits an cannot mimic the full range of the theoretical optimal ”gray” solution, as for example a minimal density (maximum porosity). To this end, we propose a generalized topology and local porosity optimization on a macroscopic, single scale approach, where the topology and the local porosity are treated as independent design variables.},
	urldate = {2026-06-05},
	publisher = {Research Square},
	author = {Pravda, Ján and Jantos, Dustin R. and Junker, Philipp},
	month = jun,
	year = {2026},
	note = {ISSN: 2693-5015},
	file = {Full Text PDF:C\:\\Users\\pravda\\Zotero\\storage\\SCC3Q4ZS\\Pravda et al. - 2026 - Macroscopic Porosity Optimization using Thermodynamic Topology Optimization.pdf:application/pdf},
}
