\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{A different convention could assign the crack tip to the opposite side of the open pore, but the present definition is used consistently as a tracking quantity for the advance through intact material ligaments.}}{28}{section*.219}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{For this fixed wall width, the ordering can be interpreted through the different resistance against crack re-nucleation and the additional energy dissipated during ligament failure.}}{29}{section*.220}\protected@file@percent }
