\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The two-dimensional simulations in this section are carried out under plane strain assumptions.}}{27}{section*.212}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The parameter set [\textbf  {Eq$\boldsymbol  {J_c}$}]\xspace  is chosen to have the same prescribed microscopic fracture resistance $J_c$ as [\textbf  {vM}]\xspace  , whereas [\textbf  {Eq$\boldsymbol  {\sigma ^*}$}]\xspace  is chosen such that the one-dimensional tensile strength is close to that of [\textbf  {vM}]\xspace  .}}{27}{section*.213}\protected@file@percent }
