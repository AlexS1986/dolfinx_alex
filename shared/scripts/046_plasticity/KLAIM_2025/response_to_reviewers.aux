\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The comparison of [\textbf  {vM}]\xspace  and [\textbf  {Eq$\boldsymbol  {\sigma ^*}$}]\xspace  in Fig.\nobreakspace  {}14 shows that the ductile material law leads to a substantially higher effective crack resistance even though the one-dimensional tensile strengths are almost identical.}}{10}{section*.59}\protected@file@percent }
