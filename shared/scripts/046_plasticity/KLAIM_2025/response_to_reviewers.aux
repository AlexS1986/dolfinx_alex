\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The comparison shows that matching this stress level alone does not reproduce the crack resistance obtained with the ductile material law, because the additional energy dissipated during plastic deformation and crack re-nucleation is decisive.}}{24}{section*.200}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{A more detailed separation of the individual mechanisms, in particular stress-driven crack nucleation under plasticity, plastic dissipation during ligament failure, and subsequent crack growth between pores, should be addressed in future work.}}{24}{section*.201}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Recent contributions underline that this remains an active field of research. Liu and Shen propose a phase-field formulation for anisotropic effective fracture toughness that accounts for a quasi-worst-case translation of a representative volume element.}}{25}{section*.202}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Aranda and Segurado introduce a crack-length control technique for phase-field fracture in FFT homogenization and use it to estimate effective fracture properties of composites and porous materials.}}{25}{section*.203}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Man et al. study how crack guiding and trapping in bioinspired interfaces control effective toughness, while Henry shows for dynamic crack propagation in disordered heterogeneous materials that the spatial distribution of soft inclusions can strongly affect the apparent fracture energy even when the effective elastic properties are similar.}}{25}{section*.204}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Added the recent references suggested by the reviewer: Liu and Shen (2025), Aranda and Segurado (2025), Man et al. (2025), and Henry (2025).}}{25}{section*.205}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The recorded value is, of course, affected by the crack pattern inside the explicitly resolved microstructure; however, following the observation reported by Hossain et al., the additional homogeneous surrounding material is assumed not to change the value of the boundary J-Integral, so that evaluating it at the boundary of the resolved microstructure or at the boundary of an embedding region with representative effective properties gives the same macroscopic driving force.}}{26}{section*.206}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The union of the representative region and the surrounding matrix is considered as a continuum $\Omega $ with boundary $\partial \Omega $.}}{26}{section*.207}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Displacements associated with mode I crack opening are prescribed at the boundary $\partial \Omega $ using a fictitious stress intensity factor $K_I^{\mathrm  {bc}}$.}}{26}{section*.208}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{A recent related development is the variable stiffness boundary condition of Hao et al., which builds on the surfing boundary condition but translates a simple uniform remote displacement into a non-uniform load through an engineered stiffness gradient, thereby facilitating implementation in experiments and commercial finite-element software.}}{27}{section*.209}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Added Hao, Piel and Hossain (2026).}}{27}{section*.210}\protected@file@percent }
