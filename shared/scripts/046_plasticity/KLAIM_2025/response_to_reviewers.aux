\@writefile{loc}{\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{The insensitivity of the computed crack resistance with respect to the precise implementation of boundary conditions has been demonstrated in previous studies.}}{6}{section*.25}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{For the numerical experiment introduced by Hossain et al., two formulations of the surfing boundary conditions were compared in the cited previous studies. For the specific cases investigated there, including the formulation used in the present work, no relevant difference in the predicted value of $J_{x,c}^{\text  {eff}}$ was found. This should not be understood as a general proof of independence from the boundary conditions.}}{6}{section*.26}\protected@file@percent }
\@writefile{loc}{\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{Finally, the fracture energy contribution is given by}}{6}{section*.27}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Finally, the fracture energy density per unit volume is given by}}{6}{section*.28}\protected@file@percent }
\@writefile{loc}{\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{Here, $\bar  {A}$ approximates the crack surface, $J_c$ denotes the material-specific fracture energy per unit crack surface area, and $\epsilon $ controls the width of the diffuse crack zone.}}{6}{section*.29}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Here, $\bar  {A}$ approximates the crack surface when integrated over a volume, $J_c$ denotes the material-specific fracture energy per unit crack surface area, and $\epsilon $ controls the width of the diffuse crack zone.}}{6}{section*.30}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{A new subsection ``Numerical implementation'' was added before the parameter sets.}}{7}{section*.31}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The weak forms of the coupled boundary-value problems are implemented in FEniCSx using \texttt  {dolfinx} version 0.7.4\nobreakspace  {}[24]. The displacement field, the phase field, and, where applicable, the plastic internal variables are solved in a monolithic nonlinear system. The linear subproblems arising within Newton's method are solved with the default PETSc Krylov solver GMRES and the default PETSc ILU preconditioner used by this setup.}}{7}{section*.32}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Irreversibility of crack growth is enforced in both the ductile and the linear elastic phase-field formulations by fixing the phase field at fully fractured points: if $s(\boldsymbol  {x},t_{\boldsymbol  {x}})=0$ for the first time $t_{\boldsymbol  {x}}$ at a point $\boldsymbol  {x}$, then a Dirichlet condition $s(\boldsymbol  {x},t)=0$ is imposed for all later pseudo-times $t>t_{\boldsymbol  {x}}$.}}{7}{section*.33}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The evolution equation for the phase field, Eq.\nobreakspace  {}(22), is discretized in pseudo-time by an implicit backward Euler scheme. The time step is adapted automatically during the simulation.}}{7}{section*.34}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The spatial discretization uses first-order Lagrange finite elements on triangular meshes in two dimensions and tetrahedral meshes in three dimensions. Along the expected crack path, the mesh is locally refined such that the element edge length satisfies $\Delta h \leq \epsilon /2$ and is usually chosen much smaller; see the respective sections for the specific values.}}{7}{section*.35}\protected@file@percent }
\@writefile{loc}{\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{Influence of Material Constitutive Laws on Effective Crack Resistance in Heterogeneous Materials}}{8}{section*.36}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Influence of J2-plasticity on the effective crack resistance of a simplified porous material in a numerical experiment}}{8}{section*.37}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{In contrast to the effective elastic or plastic properties obtained in classical micromechanics, it is presently not established in general that fracture in a heterogeneous material gives rise to a homogenized macroscopic material model with a well-defined fracture toughness obtained in an RVE limit.}}{8}{section*.38}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The methodology is not used here as a proof of a homogenized fracture toughness in the mathematical sense. Rather, it is interpreted as a numerical counterpart of a fracture experiment. In this experiment-like setting, a representative material region containing microstructural features is subjected to so-called surfing boundary conditions that enforce complete separation, and the energetic driving force required for this process is recorded.}}{8}{section*.39}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{It should therefore be understood as an operational definition of an effective crack resistance for a prescribed numerical experiment, not as a classical homogenization result.}}{8}{section*.40}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{This definition should not be confused with a proof that $J_{x,c}^{\text  {eff}}$ converges to a material property under enlargement of the representative region.}}{8}{section*.41}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{In the present work, this requirement is not fully verified: only one prescribed macroscopic crack-growth direction and one initial crack location are considered, and no convergence study with respect to the size of the resolved porous region is performed. The results should therefore be read as a controlled numerical experiment on the influence of J2-plasticity for the selected simplified microstructure, rather than as the determination of a generally valid homogenized fracture toughness.}}{8}{section*.42}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{A further essential step is to investigate representativity more systematically, including variations of the initial crack position, crack-growth direction, microstructure realization, and domain size.}}{8}{section*.43}\protected@file@percent }
\@writefile{loc}{\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{effective crack resistance as a macroscopic material parameter}}{9}{section*.44}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{effective crack resistance}}{9}{section*.45}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{To avoid conflating two slightly different concepts, the term \textsl  {effective crack resistance} is used in this work for the value obtained from a numerical experiment under specific less general conditions, i.e., the maximum energetic driving force required to force crack advance through the considered microstructure. In contrast, \textsl  {fracture toughness} is reserved for a generalized material quantity in the sense of a macroscopic fracture property. Whether such a fracture toughness exists for heterogeneous materials and under which circumstances both concepts might coincide remains an open question of research.}}{9}{section*.46}\protected@file@percent }
