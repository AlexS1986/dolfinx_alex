\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The smoother behavior is consistent with the crack-front evolution shown in Fig.\nobreakspace  {}17: in contrast to the two-dimensional case in Fig.\nobreakspace  {}9, the crack front can propagate between pores and is not trapped completely by a pore.}}{30}{section*.224}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Nevertheless, Figs.\nobreakspace  {}17 and\nobreakspace  {}18 still show phases of nearly instantaneous crack advance and elevated values of the J-Integral when the crack front is forced to pass between pores.}}{30}{section*.225}\protected@file@percent }
