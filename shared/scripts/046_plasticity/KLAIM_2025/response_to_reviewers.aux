\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Recent contributions underline that this remains an active field of research. Liu and Shen propose a phase-field formulation for anisotropic effective fracture toughness that accounts for a quasi-worst-case translation of a representative volume element. Aranda and Segurado introduce a crack-length control technique for phase-field fracture in FFT homogenization and use it to estimate effective fracture properties of composites and porous materials. Man et al. study how crack guiding and trapping in bioinspired interfaces control effective toughness, while Henry shows for dynamic crack propagation in disordered heterogeneous materials that the spatial distribution of soft inclusions can strongly affect the apparent fracture energy even when the effective elastic properties are similar.}}{11}{section*.63}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{For ductile materials, phase-field fracture has also been coupled to plasticity in variational finite-strain formulations, for example by Miehe, Aldakheel and co-workers.}}{11}{section*.64}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Related variational finite-strain phase-field formulations for ductile fracture and porous plasticity were developed by Miehe, Aldakheel and co-workers.}}{11}{section*.65}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Added Liu and Shen (2025), Aranda and Segurado (2025), Man et al. (2025), Henry (2025), Miehe, Aldakheel and Raina (2016), Miehe, Kienle, Aldakheel and Teichtmeister (2016), and Miehe, Aldakheel and Teichtmeister (2017).}}{11}{section*.66}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Here, $t$ denotes the pseudo-time, or loading parameter, used to advance the fictitious crack tip.}}{11}{section*.67}\protected@file@percent }
\@writefile{loc}{\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{The strain energy density is given by $\psi _{\text  {el}}$}}{11}{section*.68}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The strain energy density entering the J-Integral is denoted by $\psi _{\text  {el}}$ and is specified in Section\nobreakspace  {}2}}{11}{section*.69}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Thus, the unit cell used to determine the effective stiffness is cubic, whereas the surrounding homogeneous domain is a larger cuboidal embedding region assigned this effective stiffness.}}{12}{section*.70}\protected@file@percent }
