\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{The methodology is not used here as a proof of a homogenized fracture toughness in the mathematical sense. Rather, it is interpreted as a numerical counterpart of a fracture experiment. In this experiment-like setting, a representative material region containing microstructural features is subjected to so-called surfing boundary conditions that enforce complete separation, and the energetic driving force required for this process is recorded.}}{4}{section*.16}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{It should therefore be understood as an operational definition of an effective crack resistance for a prescribed numerical experiment, not as a classical homogenization result.}}{4}{section*.17}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Such a use is justified only to the extent that the fracture process analyzed by\nobreakspace  {}(1) is representative of the specific material and loading situation considered in the numerical experiment.}}{4}{section*.18}\protected@file@percent }
