\@writefile{loc}{\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{Influence of Material Constitutive Laws on Effective Crack Resistance in Heterogeneous Materials}}{2}{section*.3}\protected@file@percent }
